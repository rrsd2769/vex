// The target program. When this runs and prints the right number,
// the core project is done.

struct Point { x: int, y: int }

fn fib(n: int) -> int {
  if n < 2 { return n; }
  return fib(n - 1) + fib(n - 2);
}

fn main() {
  var total = 0;
  for i in 0..10 {
    total = total + fib(i);
  }
  print(total);
}
